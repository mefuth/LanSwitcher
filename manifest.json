{
  "manifest_version": 2,
  "name": "LanSwitcher",
  "version": "1.0.0",
  "description": "Переключает текущую вкладку между https://example.com и http://example.com.lan",
  "permissions": ["tabs", "activeTab"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Переключить домен (.lan)",
    "default_icon": "icon.svg"
  },
  "commands": {
    "toggle-lan-switch": {
      "suggested_key": {
        "default": "Ctrl+E"
      },
      "description": "Переключить домен текущей вкладки"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lanswitcher@futh.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
